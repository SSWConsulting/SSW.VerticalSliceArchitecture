<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets a central PackageVersion override a transitive dependency's resolved
         version without adding a direct PackageReference (used to patch MessagePack below). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.Azure.ApplicationInsights" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.Azure.AppService" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.Azure.Sql" Version="13.6.5" />
    <PackageVersion Include="EntityFrameworkCore.Exceptions.SqlServer" Version="10.0.1" />
    <PackageVersion Include="FastEndpoints.Swagger" Version="9.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <!-- Pinned to satisfy Aspire 13.6.5's transitive EF Core/Hosting requirement, now
         enforced by transitive pinning. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <!-- Must be >= the EF Core version Aspire.Microsoft.EntityFrameworkCore.SqlServer pulls
         in (10.0.x for Aspire 13.6.5), or restore fails with NU1109. Keep it, the Design
         pin, and the dotnet-ef tool version in lockstep. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0" />
    <!-- Transitive via Aspire.Microsoft.EntityFrameworkCore.SqlServer and
         EntityFrameworkCore.Exceptions.SqlServer, which still target EF Core 10. Must match the
         Relational pin: a 10.x provider on 11.x Relational compiles but throws
         MissingMethodException when the model is built. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0" />
    <!-- Transitive via Microsoft.Data.SqlClient 7.0.2 (pulled in by
         Aspire.Microsoft.EntityFrameworkCore.SqlServer and EntityFrameworkCore.Exceptions.SqlServer);
         pinned above the vulnerable version it resolves to in order to clear NU1903 (GHSA-846f-f764-76mx,
         high severity) and NU1902 (GHSA-2fmv-rv2c-59x7, moderate severity). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    <PackageVersion Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" Version="13.6.5" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.4.7" />
    <PackageVersion Include="ErrorOr" Version="2.1.1" />
    <PackageVersion Include="Vogen" Version="8.0.7" />
    <PackageVersion Include="Ardalis.Specification.EntityFrameworkCore" Version="9.3.1" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="FastEndpoints" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup Condition="$(IsAspireSharedProject) == 'true'">
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="11.0.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
  </ItemGroup>
  <ItemGroup Condition="$(IsAspireHost) == 'true'">
    <!-- Prerelease is the only channel this package has ever shipped on; there is no stable
         13.x to move to. The build number tracks the stable Aspire.Hosting.* pins, so
         bump it in lockstep with them. -->
    <PackageVersion Include="Aspire.Hosting.EntityFrameworkCore" Version="13.6.5-preview.1.26559.7" />
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.6.5" />
  </ItemGroup>
  <ItemGroup Condition="$(IsTestProject) == 'true'">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="Polly" Version="8.9.1" />
  </ItemGroup>
</Project>
